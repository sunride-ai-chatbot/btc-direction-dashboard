# All variables are optional — the app runs with defaults and no API keys.
# Copy to .env and export before starting if you want overrides (values shown are defaults).

# PORT=8787
# HOST=127.0.0.1
# DB_PATH=./data/signals.db

# Refresh intervals (milliseconds)
# REFRESH_BTC_MS=60000
# REFRESH_POLYMARKET_MS=300000
# REFRESH_MACRO_MS=900000
# REFRESH_ETF_MS=3600000
# REFRESH_SIGNAL_MS=60000

# Data files
# ETF_FLOWS_FILE=./data/etf-flows.json
# MACRO_EVENTS_FILE=./data/macro-events.json

# API bases (override for proxies/mirrors)
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# BINANCE_API_URL=https://api.binance.com
# KRAKEN_API_URL=https://api.kraken.com
# COINBASE_API_URL=https://api.exchange.coinbase.com
# FRED_CSV_URL=https://fred.stlouisfed.org/graph/fredgraph.csv

# Spot candle sources, tried in order (Binance is geo-blocked from some hosts, e.g. Railway US)
# CANDLE_SOURCES=binance,kraken,coinbase

# Derivatives positioning (tracking only, zero model weight). DERIVATIVES=off disables it.
# REFRESH_DERIVATIVES_MS=120000
# KRAKEN_FUTURES_API_URL=https://futures.kraken.com
# DERIBIT_API_URL=https://www.deribit.com
# BITMEX_API_URL=https://www.bitmex.com
# BYBIT_API_URL=https://api.bybit.com
# OKX_API_URL=https://www.okx.com
